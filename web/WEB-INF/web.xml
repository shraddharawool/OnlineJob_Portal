<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.1" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">
    <filter>
        <filter-name>AuthenticationFilter</filter-name>
        <filter-class>com.jobportal.AuthenticationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.jobportal.LoginServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.jobportal.RegisterServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ProfileServlet</servlet-name>
        <servlet-class>com.jobportal.ProfileServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CompanyProfileServlet</servlet-name>
        <servlet-class>com.jobportal.CompanyProfileServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>PostJobServlet</servlet-name>
        <servlet-class>com.jobportal.PostJobServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>PostJob_Servlet</servlet-name>
        <servlet-class>com.jobportal.PostJobServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ApplyJobServlet</servlet-name>
        <servlet-class>com.jobportal.ApplyJobServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>UpdateApplicationServlet</servlet-name>
        <servlet-class>com.jobportal.UpdateApplicationServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>EditJobServlet</servlet-name>
        <servlet-class>com.jobportal.EditJobServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>DeleteJobServlet</servlet-name>
        <servlet-class>com.jobportal.DeleteJobServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>DownloadResumeServlet</servlet-name>
        <servlet-class>com.jobportal.DownloadResumeServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.jobportal.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/LoginServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/RegisterServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ProfileServlet</servlet-name>
        <url-pattern>/ProfileServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CompanyProfileServlet</servlet-name>
        <url-pattern>/CompanyProfileServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PostJobServlet</servlet-name>
        <url-pattern>/PostJobServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PostJob_Servlet</servlet-name>
        <url-pattern>/PostJob_Servlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ApplyJobServlet</servlet-name>
        <url-pattern>/ApplyJobServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>UpdateApplicationServlet</servlet-name>
        <url-pattern>/UpdateApplicationServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>EditJobServlet</servlet-name>
        <url-pattern>/EditJobServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DeleteJobServlet</servlet-name>
        <url-pattern>/DeleteJobServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DownloadResumeServlet</servlet-name>
        <url-pattern>/DownloadResumeServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/LogoutServlet</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
</web-app>
